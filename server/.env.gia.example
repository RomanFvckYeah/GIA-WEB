# Copiar a .env.gia y llenar con los valores reales. .env.gia NO debe subirse a git (agrégalo a
# .gitignore si no está ya cubierto por config/config*.json) — aquí van secretos reales.

POSTGRES_USER=mmuser
POSTGRES_PASSWORD=pon-una-contraseña-fuerte-aqui
POSTGRES_DB=mattermost

SITE_URL=https://tu-dominio.com

COVIA_BASE_URL=https://api-covia.okip.com.mx/api/gia/webhook
COVIA_API_KEY=el-token-real-de-covia

SMTP_SERVER=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=el-api-key-de-resend
